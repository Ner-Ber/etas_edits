    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "MPLBACKEND": "TkAgg"
            }
        },
        {
            "name": "Python: MAGNET_ETAS_pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/runnable_code/MAGNET_ETAS_pipeline.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "MPLBACKEND": "TkAgg"
            }
        },
        {
            "name": "MAGNET pipeline: classic (etas_remote, trace log run)",
            "type": "debugpy",
            "request": "launch",
            "python": "/a/home/cc/students/csguests/neriberman/anaconda3/envs/etas_remote/bin/python",
            "pythonArgs": ["-u"],
            "program": "${workspaceFolder}/runnable_code/MAGNET_ETAS_pipeline.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--pipeline_config_json=${workspaceFolder}/outputs/pipeline_continuation_trace_logs/20260514T103525Z/pipeline_run_classic.json"
            ],
            "console": "integratedTerminal",
            "env": {
                "MPLBACKEND": "TkAgg"
            }
        },
        {
            "name": "Continuation driver: classic+grid (5k, density 0.05)",
            "type": "debugpy",
            "request": "launch",
            "python": "/a/home/cc/students/csguests/neriberman/anaconda3/envs/etas_remote/bin/python",
            "pythonArgs": ["-u"],
            "program": "${workspaceFolder}/runnable_code/run_magnet_continuation_classic_then_grid.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--max-forecast-events=5000",
                "--grid-point-density-km2",
                "0.05"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/runnable_code:/a/home/cc/students/csguests/neriberman/Repos/eq_mag_prediction/eq_mag_prediction",
                "MPLBACKEND": "TkAgg"
            }
        },
        {
            "name": "Continuation driver: classic+grid (no HTML report)",
            "type": "debugpy",
            "request": "launch",
            "python": "/a/home/cc/students/csguests/neriberman/anaconda3/envs/etas_remote/bin/python",
            "pythonArgs": ["-u"],
            "program": "${workspaceFolder}/runnable_code/run_magnet_continuation_classic_then_grid.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--max-forecast-events=5000",
                "--grid-point-density-km2",
                "0.05",
                "--no-report"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/runnable_code:/a/home/cc/students/csguests/neriberman/Repos/eq_mag_prediction/eq_mag_prediction",
                "MPLBACKEND": "TkAgg"
            }
        },
        {
            "name": "MAGNET pipeline: grid only (20260521T105949Z trace)",
            "type": "debugpy",
            "request": "launch",
            "python": "/a/home/cc/students/csguests/neriberman/anaconda3/envs/etas_remote/bin/python",
            "pythonArgs": ["-u"],
            "program": "${workspaceFolder}/runnable_code/MAGNET_ETAS_pipeline.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--pipeline_config_json=${workspaceFolder}/outputs/pipeline_continuation_trace_logs/20260521T105949Z/pipeline_run_grid.json"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/runnable_code:/a/home/cc/students/csguests/neriberman/Repos/eq_mag_prediction/eq_mag_prediction",
                "ETAS_SIM_TRACE_PARAMS_LOG": "${workspaceFolder}/outputs/pipeline_continuation_trace_logs/20260521T105949Z/run_grid_etas_params.jsonl",
                "ETAS_SIM_TRACE_EVENTS_LOG": "${workspaceFolder}/outputs/pipeline_continuation_trace_logs/20260521T105949Z/run_grid_events.csv",
                "ETAS_SAMPLE_KERNELS": "1",
                "ETAS_KERNEL_SAMPLES_LOG": "${workspaceFolder}/outputs/pipeline_continuation_trace_logs/20260521T105949Z/run_grid_kernel_samples.json",
                "MPLBACKEND": "TkAgg"
            }
        }
    ]
}