{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "MPLBACKEND": "TkAgg"
            }
        },
        {
            "name": "Python: MAGNET_ETAS_pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/runnable_code/MAGNET_ETAS_pipeline.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "MPLBACKEND": "TkAgg"
            }
        },
        {
            "name": "MAGNET pipeline: classic (etas_remote, trace log run)",
            "type": "debugpy",
            "request": "launch",
            "python": "/a/home/cc/students/csguests/neriberman/anaconda3/envs/etas_remote/bin/python",
            "pythonArgs": [
                "-u"
            ],
            "program": "${workspaceFolder}/runnable_code/MAGNET_ETAS_pipeline.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "--pipeline_config_json=${workspaceFolder}/outputs/pipeline_continuation_trace_logs/20260514T103525Z/pipeline_run_classic.json"
            ],
            "console": "integratedTerminal",
            "env": {
                "MPLBACKEND": "TkAgg"
            }
        },
        {
            "name": "MAGNET pipeline: classic only (vanilla)",
            "type": "debugpy",
            "request": "launch",
            "python": "/a/home/cc/students/csguests/neriberman/anaconda3/envs/etas_remote/bin/python",
            "pythonArgs": [
                "-u"
            ],
            "program": "${workspaceFolder}/runnable_code/MAGNET_ETAS_pipeline.py",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "prepare-vscode-classic-debug-trace-dir",
            "args": [
                "--pipeline_config_json=${workspaceFolder}/config/pipeline_single_source_repo_default.json"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/runnable_code:/a/home/cc/students/csguests/neriberman/Repos/eq_mag_prediction/eq_mag_prediction_clean",
                "LD_LIBRARY_PATH": "/a/home/cc/students/csguests/neriberman/anaconda3/envs/etas_remote/lib",
                "ETAS_SIM_TRACE_PARAMS_LOG": "${workspaceFolder}/outputs/pipeline_continuation_trace_logs/vscode_classic_debug/run_classic_etas_params.jsonl",
                "ETAS_SIM_TRACE_EVENTS_LOG": "${workspaceFolder}/outputs/pipeline_continuation_trace_logs/vscode_classic_debug/run_classic_events.csv",
                "ETAS_SAMPLE_KERNELS": "1",
                "ETAS_KERNEL_SAMPLES_LOG": "${workspaceFolder}/outputs/pipeline_continuation_trace_logs/vscode_classic_debug/run_classic_kernel_samples.json",
                "MPLBACKEND": "TkAgg"
            }
        }
    ]
}
