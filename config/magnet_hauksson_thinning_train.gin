# Flattened MAGNET gin for ETAS thinning_magnet training.
#
# Source (inlined; no gin `include`, so run_continuation_models.py can copy
# this file into output_root/magnet_generated/ and parse it alone):
#   eq_mag_prediction_clean/.../magnitude_prediction/magnitude_prediction_general.gin
#   eq_mag_prediction_clean/.../magnitude_prediction/hauksson.gin
#
# Use with:
#   config/hauksson_continuation_models_config.json
#   magnet.mode = train
#   magnet.gin_config_path = this file
#
# run_continuation_models.py overlays from the continuation JSON:
#   catalog (+ csv_path to prepared magnet catalog)
#   _project_utm.projection
#   train_start_time / validation_start_time / test_start_time / test_end_time
#   CatalogDomain.user_magnitude_threshold (= JSON mc)
#   optional magnet.epochs / magnet.batch_size
#
# ==============================================================================
# Macros (Hauksson.gin defaults; overwritten by the continuation runner)
# ==============================================================================
catalog = @hauksson_dataframe()
_project_utm.projection = @california_projection()
# ETAS→MAGNET catalogs only carry time/lat/lon/magnitude/depth — no FM angles.
# Keep False for thinning+MAGNET continuation training (native Hauksson can use True).
use_moment_angles = False

# Domain times in epoch seconds (UTC) — Hauksson.gin defaults
train_start_time = 347155200        # 0%, 1981
validation_start_time = 1233664779  # 65%, February 3, 2009
test_start_time = 1464044746        # 85%, May 23, 2016
test_end_time = 1577832500          # 100%, January 1, 2020


minimum_magnitude = 2.4

# ==============================================================================
# From magnitude_prediction_general.gin
# ==============================================================================
target_catalog:
    catalog = %catalog
    separate_repeating_times_in_catalog = True
    earthquake_criterion = @is_in_magnitude_range
    minimum_magnitude = %minimum_magnitude

is_in_magnitude_range:
    min_magnitude = %minimum_magnitude

CatalogDomain:
    train_start_time = %train_start_time
    validation_start_time = %validation_start_time
    test_start_time = %test_start_time
    test_end_time = %test_end_time
    # Kumaraswamy PDF support shift (= magnitude completeness). Continuation
    # runner overwrites this from JSON mc when present.
    user_magnitude_threshold = %minimum_magnitude

build_encoders:
    include_catalog_columns = True
    include_recent_earthquakes = True
    include_biggest_earthquakes = False
    include_seismicity_rate = True

_mock_earthquake.add_angles = %use_moment_angles

SeismicityRateEncoder.prepare_features:
    grid_side_deg = 0.5
    # lookback        = [1hr,12hr, 2d,    10d,   100d,   3yr,     10yr,     30yr]
    lookback_seconds = [3600, 43200, 172800, 864000,
                        8640000, 94610000, 315400000, 9461000008]
    magnitudes = [2, 3, 4, 5, 6]
SeismicityRateEncoder.build_model:
    units = [32, 32]
    kernel_regularization = @seismicity/tf.keras.regularizers.l1_l2()
seismicity/tf.keras.regularizers.l1_l2.l1 = 0
seismicity/tf.keras.regularizers.l1_l2.l2 = 2e-4

RecentEarthquakesEncoder.prepare_features:
    limit_lookback_seconds = 220752000  # 7 years
    max_earthquakes = 80
RecentEarthquakesEncoder.build_model:
    units = [24]
    kernel_regularization = @recent/tf.keras.regularizers.l1_l2()
recent/tf.keras.regularizers.l1_l2.l1 = 0
recent/tf.keras.regularizers.l1_l2.l2 = 4e-4

fully_connected_model:  # Spatial embedding
    layer_sizes = [16]
    activation = 'relu'
    kernel_regularization = @static/tf.keras.regularizers.l1_l2()
static/tf.keras.regularizers.l1_l2.l1 = 0
static/tf.keras.regularizers.l1_l2.l2 = 4e-4

BiggestEarthquakesEncoder.prepare_features:
    limit_lookback_seconds = 1000
    max_earthquakes = 50
BiggestEarthquakesEncoder.build_model:
    units = [24]
    kernel_regularization = @biggest/tf.keras.regularizers.l1_l2()
biggest/tf.keras.regularizers.l1_l2.l1 = 0
biggest/tf.keras.regularizers.l1_l2.l2 = 4e-4

magnitude_prediction_model:
    n_model_parameters = 6  # n = (m kumarswamy)*(3 DOF per kumarswamy)
    hidden_layer_sizes = [256, 64, 16]
    hidden_activation = 'tanh'
    output_activation = 'softplus'
    output_shift = 0.0
    kernel_regularization = @mag_head/tf.keras.regularizers.l1_l2()
mag_head/tf.keras.regularizers.l1_l2.l1 = 0
mag_head/tf.keras.regularizers.l1_l2.l2 = 2e-4

# ==============================================================================
# From hauksson.gin (local overrides after general)
# ==============================================================================


train_and_evaluate_magnitude_prediction_model:
    learning_rate = 1e-4
    batch_size = 256
    epochs = 150
    # Kumaraswamy PDF support stretch (shift comes from domain.magnitude_threshold).
    pdf_support_stretch = 7
    loss_function = None
    metric_functions = ()
